{
    "id": 0,
    "name": "Section assessment details",
    "description": "Review every section by discipline and course, including the number of recorded assessments.",
    "base_table": "terms",
    "joins": [
        "sections.term_fk->terms.terms_pk",
        "sections.course_fk->courses.courses_pk",
        "courses.discipline_fk->disciplines.disciplines_pk",
        "enrollment.section_fk->sections.sections_pk",
        "assessments.enrollment_fk->enrollment.enrollment_pk"
    ],
    "columns": [
        { "table": "terms", "field": "term_code", "label": "Term", "aggregate": "", "sort": "asc", "break": true, "summarize": false },
        { "table": "disciplines", "field": "discipline_code", "label": "Discipline", "aggregate": "", "sort": "asc", "break": false, "summarize": false },
        { "table": "disciplines", "field": "discipline_name", "label": "Discipline name", "aggregate": "", "sort": "", "break": false, "summarize": false },
        { "table": "courses", "field": "course_number", "label": "Course", "aggregate": "", "sort": "asc", "break": false, "summarize": false },
        { "table": "courses", "field": "course_name", "label": "Course name", "aggregate": "", "sort": "", "break": false, "summarize": false },
        { "table": "sections", "field": "section_id", "label": "Section ID", "aggregate": "", "sort": "asc", "break": false, "summarize": false },
        { "table": "assessments", "field": "assessments_pk", "label": "Assessment records", "aggregate": "count_distinct", "sort": "", "break": false, "summarize": true }
    ],
    "filters": [
        { "table": "terms", "field": "term_code", "operator": "in", "control": "multi_select", "label": "Terms", "required": false, "default": [], "default_to": "" },
        { "table": "disciplines", "field": "discipline_code", "operator": "in", "control": "multi_select", "label": "Disciplines", "required": false, "default": [], "default_to": "" },
        { "table": "courses", "field": "course_number", "operator": "in", "control": "multi_select", "label": "Courses", "required": false, "default": [], "default_to": "" }
    ],
    "options": { "row_limit": 2000, "grand_total": true }
}
