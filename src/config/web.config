<?xml version="1.0" encoding="UTF-8"?>
<!--
  SLOCloud config folder lockdown (IIS).

  This folder holds config.yaml and key.yaml (master encryption keys)
  and must NEVER be served over HTTP. This file blocks the ENTIRE folder
  at the folder itself, so protection does not depend on the parent
  src/web.config being present or on this folder not being mapped as its
  own application.

  Uses a uniquely-named URL Rewrite rule (blanket match -> 404) rather than
  hiddenSegments/fileExtensions, which would collide with the identical
  entries already declared in the parent web.config and cause a 500.19.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SLOCloud - Block all access to config folder" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
