<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <!--
    LTI authentication failures are rendered as a safe, user-facing page by
    launch.php. Preserve that response (and its 401 status) instead of replacing
    it with IIS's generic "invalid credentials" page. All other application
    errors remain covered by the custom httpErrors policy below.
  -->
  <location path="lti/launch.php">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
    </system.webServer>
  </location>

  <system.webServer>

    <!-- ============================================================ -->
    <!-- URL Rewriting                                                -->
    <!-- Requires IIS URL Rewrite module                              -->
    <!-- ============================================================ -->
    <rewrite>
      <rules>

        <!-- LTI shortcut: /SLO -> /lti/launch.php -->
        <rule name="SLO to LTI Launch" stopProcessing="true">
          <match url="^SLO/?$" ignoreCase="true" />
          <action type="Rewrite" url="/lti/launch.php" appendQueryString="true" />
        </rule>

        <!-- Block access to sensitive directories -->
        <rule name="Block config" stopProcessing="true">
          <match url="(^|/)config(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>
        <rule name="Block logs" stopProcessing="true">
          <match url="(^|/)logs(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>
        <rule name="Block backups" stopProcessing="true">
          <match url="(^|/)backups(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>
        <rule name="Block archives" stopProcessing="true">
          <match url="(^|/)archives?(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>
        <rule name="Block sessions" stopProcessing="true">
          <match url="(^|/)sessions(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>
        <rule name="Block var" stopProcessing="true">
          <match url="(^|/)var(/|$)" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not found." />
        </rule>

      </rules>
    </rewrite>

    <!-- ============================================================ -->
    <!-- Default document                                             -->
    <!-- ============================================================ -->
    <defaultDocument>
      <files>
        <add value="index.php" />
      </files>
    </defaultDocument>

    <!-- ============================================================ -->
    <!-- Security Headers                                             -->
    <!-- ============================================================ -->
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
        <remove name="Server" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!-- ============================================================ -->
    <!-- Disable directory browsing                                   -->
    <!-- ============================================================ -->
    <directoryBrowse enabled="false" />

    <!-- ============================================================ -->
    <!-- Request filtering                                            -->
    <!-- ============================================================ -->
    <security>
      <requestFiltering>
        <!-- Preserve existing URL/query length limits -->
        <requestLimits maxUrl="8172" maxQueryString="8172" />
        <!-- Block sensitive file extensions -->
        <fileExtensions>
          <add fileExtension=".yaml" allowed="false" />
          <add fileExtension=".yml" allowed="false" />
          <add fileExtension=".env" allowed="false" />
        </fileExtensions>
        <!-- Block dotfiles and sensitive directory names -->
        <hiddenSegments>
          <add segment=".git" />
          <add segment=".htaccess" />
          <add segment="config" />
          <add segment="logs" />
          <add segment="backups" />
          <add segment="sessions" />
          <add segment="var" />
          <add segment="archives" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- ============================================================ -->
    <!-- Error pages (Custom mode prevents stack trace leakage)       -->
    <!-- ============================================================ -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="403" />
      <remove statusCode="404" />
      <remove statusCode="500" />
      <error statusCode="403" responseMode="File" path="errors\403.html" />
      <error statusCode="404" responseMode="File" path="errors\404.html" />
      <error statusCode="500" responseMode="File" path="errors\500.html" />
    </httpErrors>

  </system.webServer>
</configuration>
